# Basis-URL der Anwendung (für OAuth-Redirects)
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://mailwin:mailwin@localhost:5432/mailwin

# 32 Byte, base64-kodiert – verschlüsselt OAuth-Tokens (AES-256-GCM).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Google OAuth-Client (Google Cloud Console → APIs & Dienste → Anmeldedaten)
# Redirect-URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API für Marvin
ANTHROPIC_API_KEY=
